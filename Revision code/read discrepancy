library(dplyr)

# Final reads represented in phyloseq
phy_reads <- tibble(
  sample_id_phylo = names(sample_sums(physeq_no_growout3)),
  final_reads = as.numeric(sample_sums(physeq_no_growout3))
) %>%
  mutate(
    sample_num = as.integer(sub(".*_(\\d+)$", "\\1", sample_id_phylo))
  )

# Reads from FASTQ files after 800-2000 bp length filtering
fastq_reads <- per_sample_length_summary_filt_1_60 %>%
  mutate(
    sample_num = as.integer(sub(".*_(\\d+)$", "\\1", sample_id))
  ) %>%
  select(sample_num, fastq_reads = n_reads)

# Compare stages
read_comparison <- inner_join(fastq_reads, phy_reads, by = "sample_num") %>%
  mutate(
    retained_fraction = final_reads / fastq_reads,
    retained_percent = 100 * retained_fraction
  )

# Summary
read_comparison %>%
  summarise(
    n_samples = n(),
    
    fastq_total = sum(fastq_reads),
    fastq_mean = mean(fastq_reads),
    fastq_sd = sd(fastq_reads),
    fastq_min = min(fastq_reads),
    fastq_max = max(fastq_reads),
    
    final_total = sum(final_reads),
    final_mean = mean(final_reads),
    final_sd = sd(final_reads),
    final_min = min(final_reads),
    final_max = max(final_reads),
    
    mean_retained_percent = mean(retained_percent)
  )

# Inspect sample-by-sample
read_comparison %>%
  arrange(sample_num)

