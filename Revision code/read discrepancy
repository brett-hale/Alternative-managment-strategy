```{r}
# ==============================================================
# Supplementary File 1
# Per-sample sequencing read counts across processing stages
#
# Samples included:
#   1-60 and 91-93
#
# Columns:
#   Raw_reads
#     = reads in the per-sample FASTQ files before the
#       800-2000 bp length filter
#
#   Filtered_reads
#     = reads retained after the 800-2000 bp length filter
#
#   Classified_reads
#     = length-filtered reads receiving a taxonomic classification
#       in the Epi2Me wf-16s output
#
#   Analyzed_reads
#     = reads retained in the final phyloseq object used for
#       downstream biological analyses
#
# Does NOT overwrite existing objects.
# ==============================================================

library(ShortRead)
library(phyloseq)
library(dplyr)
library(tibble)

# ==============================================================
# 1. Define samples to include
# ==============================================================

supp1_sample_numbers <- c(1:60, 91:93)


# ==============================================================
# 2. Locate FASTQ files
# ==============================================================

# Root directory for sequencing run
supp1_root_dir <- "/Users/brett/Documents/DeQueen_Litter/5080"

# Find all gzipped FASTQ files
supp1_all_fastq_files <- list.files(
  path = supp1_root_dir,
  pattern = "\\.fastq\\.gz$",
  recursive = TRUE,
  full.names = TRUE
)

# Retain sequencing-pass files
supp1_fastq_pass_files <- supp1_all_fastq_files[
  grepl("fastq_pass", supp1_all_fastq_files)
]

# Extract sample ID from directory name
supp1_sample_ids <- vapply(
  supp1_fastq_pass_files,
  function(path) basename(dirname(path)),
  character(1)
)

# Extract numeric sample number
supp1_sample_nums <- as.integer(
  sub(".*_", "", supp1_sample_ids)
)

# Keep samples 1-60 and 91-93
supp1_keep <- !is.na(supp1_sample_nums) &
  supp1_sample_nums %in% supp1_sample_numbers

supp1_fastq_files_keep <- supp1_fastq_pass_files[supp1_keep]
supp1_sample_ids_keep <- supp1_sample_ids[supp1_keep]
supp1_sample_nums_keep <- supp1_sample_nums[supp1_keep]


# ==============================================================
# 3. Calculate raw/input and length-filtered reads per sample
# ==============================================================

supp1_fastq_counts <- lapply(
  supp1_sample_numbers,
  function(samp_num) {

    supp1_files_this_sample <- supp1_fastq_files_keep[
      supp1_sample_nums_keep == samp_num
    ]

    # If no FASTQ file is found, return NA
    if (length(supp1_files_this_sample) == 0) {
      return(
        data.frame(
          Sample = samp_num,
          Raw_reads = NA_real_,
          Filtered_reads_FASTQ = NA_real_
        )
      )
    }

    supp1_raw_total <- 0
    supp1_filtered_total <- 0

    for (fq in supp1_files_this_sample) {

      supp1_fq_obj <- ShortRead::readFastq(fq)

      supp1_lengths <- width(
        ShortRead::sread(supp1_fq_obj)
      )

      # Reads before the 800-2000 bp filter
      supp1_raw_total <- supp1_raw_total +
        length(supp1_lengths)

      # Reads retained after the 800-2000 bp filter
      supp1_filtered_total <- supp1_filtered_total +
        sum(
          supp1_lengths >= 800 &
          supp1_lengths <= 2000
        )
    }

    data.frame(
      Sample = samp_num,
      Raw_reads = supp1_raw_total,
      Filtered_reads_FASTQ = supp1_filtered_total
    )
  }
) %>%
  dplyr::bind_rows()


# ==============================================================
# 4. Obtain filtered and classified reads from Epi2Me output
# ==============================================================

# Identify sample columns
supp1_abundance_sample_cols <- grep(
  "^X5080_[0-9]+$",
  colnames(abundance_table_species),
  value = TRUE
)

supp1_abundance_sample_info <- data.frame(
  sample_col = supp1_abundance_sample_cols,
  Sample = as.integer(
    sub("^X5080_", "", supp1_abundance_sample_cols)
  )
) %>%
  dplyr::filter(
    Sample %in% supp1_sample_numbers
  ) %>%
  dplyr::arrange(Sample)

# Identify explicit Unclassified row
supp1_unclassified_row <- grepl(
  "^Unclassified;",
  abundance_table_species$tax
)

# Confirm exactly one Unclassified row exists
if (sum(supp1_unclassified_row) != 1) {
  stop(
    "Expected exactly one explicit Unclassified row in abundance_table_species."
  )
}

# Total filtered reads represented in Epi2Me output
supp1_filtered_epi2me <- colSums(
  abundance_table_species[
    ,
    supp1_abundance_sample_info$sample_col,
    drop = FALSE
  ],
  na.rm = TRUE
)

# Unclassified reads
supp1_unclassified_epi2me <- as.numeric(
  abundance_table_species[
    supp1_unclassified_row,
    supp1_abundance_sample_info$sample_col,
    drop = FALSE
  ]
)

# Classified reads
supp1_classified_epi2me <-
  supp1_filtered_epi2me -
  supp1_unclassified_epi2me

supp1_classification_counts <- data.frame(
  Sample = supp1_abundance_sample_info$Sample,
  Filtered_reads_Epi2Me = as.numeric(
    supp1_filtered_epi2me
  ),
  Classified_reads = as.numeric(
    supp1_classified_epi2me
  )
)


# ==============================================================
# 5. Obtain analyzed reads from final phyloseq object
# ==============================================================

supp1_analyzed_counts <- tibble::tibble(
  sample_id_phylo = names(
    phyloseq::sample_sums(physeq_no_growout3)
  ),
  Analyzed_reads = as.numeric(
    phyloseq::sample_sums(physeq_no_growout3)
  )
) %>%
  dplyr::mutate(
    Sample = as.integer(
      sub(".*_(\\d+)$", "\\1", sample_id_phylo)
    )
  ) %>%
  dplyr::filter(
    Sample %in% supp1_sample_numbers
  ) %>%
  dplyr::select(
    Sample,
    Analyzed_reads
  )


# ==============================================================
# 6. Assemble Supplementary File 1
# ==============================================================

supplementary_file1_reads <- data.frame(
  Sample = supp1_sample_numbers
) %>%
  dplyr::left_join(
    supp1_fastq_counts,
    by = "Sample"
  ) %>%
  dplyr::left_join(
    supp1_classification_counts,
    by = "Sample"
  ) %>%
  dplyr::left_join(
    supp1_analyzed_counts,
    by = "Sample"
  ) %>%
  dplyr::arrange(Sample)


# ==============================================================
# 7. Check that independently calculated filtered counts agree
# ==============================================================

supp1_filtered_check <- supplementary_file1_reads %>%
  dplyr::filter(
    !is.na(Filtered_reads_FASTQ),
    !is.na(Filtered_reads_Epi2Me)
  ) %>%
  dplyr::mutate(
    difference =
      Filtered_reads_FASTQ -
      Filtered_reads_Epi2Me
  )

# Print any discrepancies
supp1_filtered_check %>%
  dplyr::filter(difference != 0)

# Warn if discrepancies exist
if (any(supp1_filtered_check$difference != 0)) {
  warning(
    "FASTQ-derived and Epi2Me-derived filtered read counts do not match for one or more samples."
  )
}


# ==============================================================
# 8. Create final clean table
# ==============================================================

# Use the Epi2Me filtered count in the final table because it is
# directly tied to the taxonomic classification output.

Supplementary_File_1 <- supplementary_file1_reads %>%
  dplyr::transmute(
    Sample = Sample,
    Raw_reads = Raw_reads,
    Filtered_reads = Filtered_reads_Epi2Me,
    Classified_reads = Classified_reads,
    Analyzed_reads = Analyzed_reads
  )


# ==============================================================
# 9. Inspect final per-sample table
# ==============================================================

print(
  Supplementary_File_1,
  n = Inf
)


# ==============================================================
# 10. Print overall totals for samples 1-60
# ==============================================================

Supplementary_File_1 %>%
  dplyr::filter(Sample %in% 1:60) %>%
  dplyr::summarise(
    Raw_reads = sum(
      Raw_reads,
      na.rm = TRUE
    ),
    Filtered_reads = sum(
      Filtered_reads,
      na.rm = TRUE
    ),
    Classified_reads = sum(
      Classified_reads,
      na.rm = TRUE
    ),
    Analyzed_reads = sum(
      Analyzed_reads,
      na.rm = TRUE
    )
  )


# ==============================================================
# 11. Print samples 91-93 separately
# ==============================================================

Supplementary_File_1 %>%
  dplyr::filter(
    Sample %in% 91:93
  )


# ==============================================================
# 12. Write Supplementary File 1
# ==============================================================

write.csv(
  Supplementary_File_1,
  file = "Supplementary File 1.csv",
  row.names = FALSE,
  na = "NA"
)

