# ==============================================================
# Updated sequencing summary figure
#
# IMPORTANT CHANGE:
#   - "Read count" now uses reads retained in the FINAL processed
#     phyloseq dataset (physeq_no_growout3), matching the value
#     reported in the manuscript.
#
#   - "OTU count" remains the observed number of taxa per sample
#     in the final phyloseq dataset.
#
#   - "Read length (bp)" continues to use the previously generated
#     800-2000 bp filtered FASTQ read-length summary.
#
# Figure order is preserved as:
#   OTU count -> Read count -> Read length (bp)
#
# Does NOT overwrite existing objects.
# ==============================================================

library(phyloseq)
library(dplyr)
library(tidyr)
library(tibble)
library(ggplot2)
library(viridis)
library(grid)

# ==============================================================
# 1. OTUs per sample from final phyloseq object
# ==============================================================

otu_mat_suppfig2 <- as(
  phyloseq::otu_table(physeq_no_growout3),
  "matrix"
)

otus_per_sample_suppfig2 <- if (
  phyloseq::taxa_are_rows(physeq_no_growout3)
) {
  colSums(otu_mat_suppfig2 > 0)
} else {
  rowSums(otu_mat_suppfig2 > 0)
}

otus_df_suppfig2 <- tibble::tibble(
  sample_id_phylo = names(otus_per_sample_suppfig2),
  otus = as.numeric(otus_per_sample_suppfig2)
) %>%
  dplyr::mutate(
    sample_num = as.integer(
      sub(".*_(\\d+)$", "\\1", sample_id_phylo)
    )
  ) %>%
  dplyr::filter(
    !is.na(sample_num),
    sample_num >= 1L,
    sample_num <= 60L
  )

# ==============================================================
# 2. Final processed read counts from phyloseq
# ==============================================================

final_reads_df_suppfig2 <- tibble::tibble(
  sample_id_phylo = names(
    phyloseq::sample_sums(physeq_no_growout3)
  ),
  final_reads = as.numeric(
    phyloseq::sample_sums(physeq_no_growout3)
  )
) %>%
  dplyr::mutate(
    sample_num = as.integer(
      sub(".*_(\\d+)$", "\\1", sample_id_phylo)
    )
  ) %>%
  dplyr::filter(
    !is.na(sample_num),
    sample_num >= 1L,
    sample_num <= 60L
  ) %>%
  dplyr::select(
    sample_num,
    final_reads
  )

# ==============================================================
# 3. Mean read length from previous 800-2000 bp FASTQ summary
# ==============================================================

read_lengths_df_suppfig2 <- per_sample_length_summary_filt_1_60 %>%
  dplyr::mutate(
    sample_num = as.integer(
      sub(".*_(\\d+)$", "\\1", sample_id)
    )
  ) %>%
  dplyr::filter(
    !is.na(sample_num),
    sample_num >= 1L,
    sample_num <= 60L
  ) %>%
  dplyr::select(
    sample_num,
    mean_len
  )

# ==============================================================
# 4. Join metrics by sample
# ==============================================================

plot_df_suppfig2 <- final_reads_df_suppfig2 %>%
  dplyr::inner_join(
    otus_df_suppfig2 %>%
      dplyr::select(sample_num, otus),
    by = "sample_num"
  ) %>%
  dplyr::inner_join(
    read_lengths_df_suppfig2,
    by = "sample_num"
  ) %>%
  dplyr::transmute(
    sample_num,
    `OTU count` = otus,
    `Read count` = final_reads,
    `Read length (bp)` = mean_len
  ) %>%
  tidyr::pivot_longer(
    cols = -sample_num,
    names_to = "Metric",
    values_to = "Value"
  ) %>%
  dplyr::mutate(
    Metric = factor(
      Metric,
      levels = c(
        "OTU count",
        "Read count",
        "Read length (bp)"
      )
    )
  )

# Guard against failed joins
if (nrow(plot_df_suppfig2) == 0) {
  stop(
    "No overlapping samples after harmonizing IDs. Check sample naming."
  )
}

# Sanity check: should be 60 observations per metric
table(plot_df_suppfig2$Metric)

# ==============================================================
# 5. Per-facet summary statistics
# ==============================================================

stats_df_suppfig2 <- plot_df_suppfig2 %>%
  dplyr::group_by(Metric) %>%
  dplyr::summarise(
    mean = mean(Value, na.rm = TRUE),
    q1 = stats::quantile(
      Value,
      0.25,
      na.rm = TRUE
    ),
    q3 = stats::quantile(
      Value,
      0.75,
      na.rm = TRUE
    ),
    .groups = "drop"
  )

stats_df_suppfig2

# ==============================================================
# 6. Updated figure
# ==============================================================

sequencing_summary_plot_suppfig2 <- ggplot(
  plot_df_suppfig2,
  aes(
    x = Value,
    fill = Metric
  )
) +
  geom_density(
    alpha = 0.8
  ) +
  geom_vline(
    data = stats_df_suppfig2,
    aes(xintercept = mean),
    linewidth = 0.7
  ) +
  geom_vline(
    data = stats_df_suppfig2,
    aes(xintercept = q1),
    linetype = "dashed",
    linewidth = 0.6
  ) +
  geom_vline(
    data = stats_df_suppfig2,
    aes(xintercept = q3),
    linetype = "dashed",
    linewidth = 0.6
  ) +
  facet_wrap(
    ~ Metric,
    scales = "free",
    nrow = 1
  ) +
  scale_fill_viridis_d(
    option = "magma"
  ) +
  labs(
    x = NULL,
    y = "Density"
  ) +
  guides(
    fill = "none"
  ) +
  theme_bw() +
